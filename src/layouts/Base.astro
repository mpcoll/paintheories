---
import '../styles/global.css';
import { url } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  /** Set to false for pages that should not be indexed by site search. */
  searchable?: boolean;
}
const {
  title,
  description = 'Pain Knowledge: an open, structured portal on pain science.',
  searchable = true,
} = Astro.props;
const fullTitle = title === 'Pain Knowledge' ? title : `${title} · Pain Knowledge`;
const here = Astro.url.pathname;
const is = (path: string) => here.startsWith(url(path));

// Portal-level navigation (modules + shared resources).
const nav: [string, string][] = [
  ['theories/', 'Theories'],
  ['biology/', 'Biology'],
  ['references/', 'References'],
  ['search/', 'Search'],
  ['about/', 'About'],
];

// Module sub-navigation for Pain Theories.
const theorySub: [string, string, boolean][] = [
  ['theories/', 'Overview', here === url('theories/')],
  ['theories/all/', 'All theories', is('theories/all/') || (/^\/theories\/[^/]+\/$/.test(here.replace(url(), '/')) && !['map', 'timeline', 'compare', 'evidence', 'gaps', 'all'].some((p) => is(`theories/${p}/`)))],
  ['theories/map/', 'Map', is('theories/map/')],
  ['theories/timeline/', 'Timeline', is('theories/timeline/')],
  ['theories/compare/', 'Compare', is('theories/compare/')],
  ['theories/evidence/', 'Evidence', is('theories/evidence/')],
  ['theories/gaps/', 'Gaps', is('theories/gaps/')],
];
const inTheories = is('theories/');
const inBiology = is('biology/') || is('mechanisms/');
const biologySub: [string, string, boolean][] = [
  ['biology/', 'Pain circuits', here === url('biology/')],
  ['mechanisms/', 'Mechanisms', is('mechanisms/')],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url()}>
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><g stroke="currentColor" stroke-width="1.6" fill="none" opacity=".55"><path d="M6 23 L15 9 L26 16 L20 26 Z" /></g><circle cx="6" cy="23" r="3.4" fill="var(--d1)" /><circle cx="15" cy="9" r="3.4" fill="var(--d2)" /><circle cx="26" cy="16" r="3.4" fill="var(--d3)" /><circle cx="20" cy="26" r="3.4" fill="var(--d4)" /></svg>
          <span>Pain <em>Knowledge</em></span>
        </a>
        <nav class="nav" aria-label="Main">
          {
            nav.map(([href, label]) => (
              <a href={url(href)} aria-current={is(href) || (href === 'biology/' && inBiology) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle colour theme" title="Toggle light/dark"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg></button>
      </div>
      {inBiology && (
        <div class="subnav">
          <div class="wrap">
            <a class="module-name" href={url('biology/')}>Pain Biology</a>
            <nav aria-label="Pain Biology">
              {biologySub.map(([href, label, active]) => (
                <a href={url(href)} aria-current={active ? 'page' : undefined}>{label}</a>
              ))}
            </nav>
          </div>
        </div>
      )}
      {inTheories && (
        <div class="subnav">
          <div class="wrap">
            <a class="module-name" href={url('theories/')}>Pain Theories</a>
            <nav aria-label="Pain Theories">
              {theorySub.map(([href, label, active]) => (
                <a href={url(href)} aria-current={active ? 'page' : undefined}>{label}</a>
              ))}
            </nav>
          </div>
        </div>
      )}
    </header>
    <main class="wrap" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="brand">Pain <em>Knowledge</em></p>
          <p>An open, structured portal on pain science: theories, mechanisms and the evidence behind them. Content <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, code MIT.</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={url('data/')}>Download the data</a>
          <a href={url('about/#cite')}>How to cite</a>
          <a href={url('about/#contribute')}>Report an error</a>
          <a href="https://github.com/mpcoll/paintheories">Source on GitHub</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
        window.dispatchEvent(new Event('themechange'));
      });
    </script>
  </body>
</html>
