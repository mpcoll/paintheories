---
import Base from '../../layouts/Base.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import { getTheories, getReferences, cite, url } from '../../lib/data';
import { EVIDENCE_METHODS } from '../../data/taxonomy';

const theories = await getTheories();
const refs = new Map((await getReferences()).map((r) => [r.id, r]));
const rows = theories
  .map((t) => {
    const n = (d: string) => t.data.evidence.filter((e) => e.direction === d).length;
    return { t, s: n('supports'), c: n('contradicts'), m: n('mixed'), total: t.data.evidence.length };
  })
  .filter((r) => r.total > 0);
const maxTotal = Math.max(1, ...rows.map((r) => r.total));
const findings = theories.flatMap((t) => t.data.evidence.map((e) => ({ t, e })));
const icon = { supports: '✓', contradicts: '✕', mixed: '±' } as const;
const dirLabel = { supports: 'Supports', contradicts: 'Contradicts', mixed: 'Mixed' } as const;
const usedMethods = [...new Set(findings.map((f) => f.e.method).filter(Boolean))] as (keyof typeof EVIDENCE_METHODS)[];
---

<Base title="Evidence" description="Key empirical findings supporting and contradicting pain theories, with links to the papers.">
  <header class="page-head">
    <p class="eyebrow">Evidence</p>
    <h1>Key findings across theories</h1>
    <p class="lede">{findings.length} empirical findings bearing on {rows.length} theories, each linked to the papers that report it. Use the table for the overall balance and the list to filter findings by theory, direction or study type.</p>
  </header>

  <h2>Evidence balance</h2>
  <p class="muted" style="font-size:.9rem;margin-top:0">Counts of key findings listed on each theory page. These are curated highlights, not a systematic review: a higher count means more is documented here, not that a theory is better supported.</p>
  <div class="table-wrap">
    <table class="balance">
      <thead><tr><th>Theory</th><th style="text-align:right">✓ Supporting</th><th style="text-align:right">✕ Contradicting</th><th style="text-align:right">± Mixed</th><th style="min-width:180px">Balance</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td><a href={url(`theories/${r.t.id}/#key-findings`)}>{r.t.data.shortTitle ?? r.t.data.title}</a> <span class="muted" style="font-size:.8rem">{r.t.data.year}</span></td>
            <td class="num">{r.s}</td>
            <td class="num">{r.c}</td>
            <td class="num">{r.m}</td>
            <td>
              <div class="bar" role="img" aria-label={`${r.s} supporting, ${r.c} contradicting, ${r.m} mixed`} style={`width:${(r.total / maxTotal) * 100}%`}>
                {r.s > 0 && <span class="seg s" style={`flex:${r.s}`} />}
                {r.c > 0 && <span class="seg c" style={`flex:${r.c}`} />}
                {r.m > 0 && <span class="seg m" style={`flex:${r.m}`} />}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>All findings</h2>
  <form class="filters" id="ev-filters" data-pagefind-ignore>
    <label>Search<input type="search" name="q" placeholder="e.g. placebo, fibromyalgia, fMRI" /></label>
    <label>Theory
      <select name="theory"><option value="">All</option>{rows.map((r) => <option value={r.t.id}>{r.t.data.shortTitle ?? r.t.data.title}</option>)}</select>
    </label>
    <label>Direction
      <select name="direction"><option value="">All</option><option value="supports">Supports</option><option value="contradicts">Contradicts</option><option value="mixed">Mixed</option></select>
    </label>
    <label>Study type
      <select name="method"><option value="">All</option>{usedMethods.map((m) => <option value={m}>{EVIDENCE_METHODS[m].label}</option>)}</select>
    </label>
    <button class="btn" type="reset">Clear</button>
  </form>
  <p class="muted" id="ev-count" aria-live="polite" style="font-size:.9rem"></p>

  <ul class="ev-all">
    {findings.map(({ t, e }) => (
      <li
        class={`ev-row ev-${e.direction}`}
        data-theory={t.id}
        data-direction={e.direction}
        data-method={e.method ?? ''}
        data-text={`${t.data.title} ${e.finding} ${e.refs.map((r) => cite(refs.get(r.id)!)).join(' ')}`.toLowerCase()}
      >
        <span class="ev-badge" title={dirLabel[e.direction]}><span aria-hidden="true">{icon[e.direction]}</span><span class="sr">{dirLabel[e.direction]}</span></span>
        <div>
          <p class="ev-theory"><a href={url(`theories/${t.id}/#key-findings`)}>{t.data.shortTitle ?? t.data.title}</a> · <span>{dirLabel[e.direction]}</span>{e.method && <> · {EVIDENCE_METHODS[e.method].label}</>}</p>
          <p class="ev-text">{e.finding}</p>
          <p class="ev-refs">
            {e.refs.map((r) => {
              const ref = refs.get(r.id)!;
              return <a href={ref.data.doi ? `https://doi.org/${ref.data.doi}` : url(`references/#${r.id}`)} title={ref.data.title}>{cite(ref)}{ref.data.doi && ' ↗'}</a>;
            })}
          </p>
        </div>
      </li>
    ))}
  </ul>

  <p class="muted" style="font-size:.85rem">Download as <a href={url('data/evidence.csv')}>evidence.csv</a>.</p>

  <style>
    .num { text-align: right; font-variant-numeric: tabular-nums; }
    .bar { display: flex; gap: 2px; height: 12px; min-width: 6px; }
    .seg { border-radius: 3px; }
    .seg.s { background: var(--ev-support); }
    .seg.c { background: var(--ev-contra); }
    .seg.m { background: var(--ev-mixed); }
    .ev-all { list-style: none; padding: 0; display: grid; gap: .6rem; max-width: 900px; }
    .ev-row { display: grid; grid-template-columns: 2rem 1fr; gap: .75rem; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: .8rem 1rem; }
    .ev-badge { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; color: var(--surface); font-weight: 700; font-size: .85rem; margin-top: .1rem; }
    .ev-supports .ev-badge { background: var(--ev-support); }
    .ev-contradicts .ev-badge { background: var(--ev-contra); }
    .ev-mixed .ev-badge { background: var(--ev-mixed); }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ev-theory { margin: 0; font-size: .82rem; color: var(--ink-3); }
    .ev-theory a { font-weight: 600; }
    .ev-text { margin: .2rem 0 .35rem; }
    .ev-refs { margin: 0; display: flex; flex-wrap: wrap; gap: .25rem .8rem; font-size: .84rem; }
    .ev-refs a { text-decoration: none; font-weight: 500; }
  </style>

  <script>
    const form = document.getElementById('ev-filters') as HTMLFormElement;
    const items = Array.from(document.querySelectorAll<HTMLLIElement>('.ev-row'));
    const count = document.getElementById('ev-count')!;
    function apply() {
      const fd = new FormData(form);
      const q = String(fd.get('q') ?? '').toLowerCase().trim();
      let n = 0;
      for (const li of items) {
        let ok = !q || q.split(/\s+/).every((w) => li.dataset.text!.includes(w));
        for (const k of ['theory', 'direction', 'method']) {
          const v = String(fd.get(k) ?? '');
          if (v) ok &&= li.dataset[k] === v;
        }
        li.hidden = !ok;
        if (ok) n++;
      }
      count.textContent = `${n} of ${items.length} findings shown`;
      const params = new URLSearchParams();
      for (const [k, v] of fd.entries()) if (v) params.set(k, String(v));
      history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    }
    for (const [k, v] of new URLSearchParams(location.search)) {
      const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = v;
    }
    form.addEventListener('input', apply);
    form.addEventListener('reset', () => setTimeout(apply));
    form.addEventListener('submit', (e) => e.preventDefault());
    apply();
  </script>
</Base>
