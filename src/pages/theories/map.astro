---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getTheories, theoryRecord, url } from '../../lib/data';
import { DOMAINS, DOMAIN_STYLE, RELATIONS } from '../../data/taxonomy';
import MapFilters from '../../components/MapFilters.astro';
import SizeToggle from '../../components/SizeToggle.astro';
import { computeMetrics, scales } from '../../lib/metrics';
import { filterCounts } from '../../lib/filters';

const theoryEntries = await getTheories();
const theories = theoryEntries.map(theoryRecord);
const mechanisms = (await getCollection('mechanisms')).map((m) => ({
  id: m.id,
  title: m.data.title,
  summary: m.data.summary,
  url: url(`mechanisms/${m.id}/`),
}));
const metrics = computeMetrics(theoryEntries);
const { out: SC, maxC, maxI } = scales(metrics);
const sizes = Object.fromEntries([...SC].map(([id, v]) => [id, { ...v, citationsN: metrics.get(id)!.citations, influenceN: metrics.get(id)!.influence }]));
const payload = { theories, mechanisms, domainStyle: DOMAIN_STYLE, relations: RELATIONS, domains: DOMAINS, sizes };
---

<Base title="Network map" description="Interactive network of pain theories and how they relate." searchable={false}>
  <header class="map-head">
    <h1>Network map</h1>
    <p class="muted">Colour and shape show the domain; lines show relations. Click a node for details, double-click to open its page.</p>
  </header>

  <div class="card map-controls" data-pagefind-ignore>
    <div class="row">
      <label class="ctl">Layout
        <select id="layout">
          <option value="time">Time × domain</option>
          <option value="force">Force-directed</option>
        </select>
      </label>
      <label class="ctl-check"><input type="checkbox" id="show-mech" /> Show mechanisms</label>
      <button class="btn" id="fit" type="button">Reset view</button>
    </div>
    <MapFilters counts={filterCounts(theoryEntries)} />
    <SizeToggle maxCitations={maxC} maxInfluence={maxI} />
    <ul class="legend" aria-label="Legend">
      {Object.entries(DOMAINS).map(([k, v]) => (
        <li><span class={`sym dom-${k}`} aria-hidden="true">{DOMAIN_STYLE[k as keyof typeof DOMAIN_STYLE].symbol}</span>{v.label}</li>
      ))}
      <li class="sep" aria-hidden="true"></li>
      <li><svg width="24" height="8" aria-hidden="true"><line x1="0" y1="4" x2="24" y2="4" stroke="currentColor" stroke-width="2" /></svg>builds on / extends</li>
      <li><svg width="24" height="8" aria-hidden="true"><line x1="0" y1="4" x2="24" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray="6 4" /></svg>challenges</li>
      <li><svg width="24" height="8" aria-hidden="true"><line x1="0" y1="4" x2="24" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray="1 4" stroke-linecap="round" /></svg>integrates / related to</li>
    </ul>
  </div>

  <div class="map-shell">
    <div id="cy" role="img" aria-label="Network diagram of pain theories. The same information is available in the theories table."></div>
    <aside id="panel" class="card" aria-live="polite">
      <p class="muted" style="margin:0">Select a node to see details.</p>
    </aside>
  </div>
  <p class="muted" style="font-size:.85rem">Prefer a list? The same information is in the <a href={url('theories/all/')}>theories table</a>.</p>

  <script type="application/json" id="map-data" set:html={JSON.stringify(payload)} />

  <style>
    .map-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem 1.25rem; margin-bottom: 1rem; }
    .map-head h1 { font-size: 2rem; margin: 0; }
    .map-head p { margin: 0; font-size: .92rem; }
    .map-controls { display: grid; gap: .6rem; margin-bottom: 1rem; padding: .9rem 1.1rem; }
    .map-controls .row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; }
    .map-controls :global(.map-filters) { margin: 0; }
    .map-controls .legend { margin: 0; font-size: .8rem; }
    .legend .sep { width: 1px; height: 14px; background: var(--line-strong); }
    .ctl { display: flex; align-items: center; gap: .5rem; font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); }
    .ctl-check { display: flex; align-items: center; gap: .4rem; font-size: .9rem; color: var(--ink-2); }
    .map-shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 1rem;
      align-items: start;
    }
    #cy {
      height: 72vh;
      min-height: 420px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
    #panel { font-size: .92rem; min-height: 120px; }
    #panel h3 { margin: 0 0 .25rem; }
    @media (max-width: 800px) {
      .map-shell { grid-template-columns: 1fr; }
      #cy { height: 60vh; }
    }
  </style>

  <script>
    import cytoscape from 'cytoscape';
    import { makeTimeScale, tickYears as ticksFor } from '../../lib/timescale';
    import { matchesFilter, type MapFilter } from '../../lib/filters';

    type Payload = {
      theories: any[];
      mechanisms: { id: string; title: string; summary: string; url: string }[];
      domainStyle: Record<string, { slot: number; shape: string }>;
      relations: Record<string, { label: string; inverse?: string }>;
      domains: Record<string, { label: string }>;
    };
    const data: Payload = JSON.parse(document.getElementById('map-data')!.textContent!);
    const domainOrder = Object.keys(data.domains);
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    const years = data.theories.map((t) => t.year);
    const minY = Math.min(...years), maxY = Math.max(...years);
    // Compress early history: position on a sqrt scale of years since the earliest entry.
    // Piecewise time scale: everything before 1850 is compressed into a narrow band on the left.
    const xFor = makeTimeScale(minY, maxY, 0, 2600, 120, 120);

    const MIN_GAP = 190, ROW_H = 70, BAND_GAP = 70;
    const placed: Record<string, { x: number; sub: number }> = {};
    const subRows: Record<string, number[]> = {};
    for (const t of data.theories) {
      const x = xFor(t.year);
      const rows = (subRows[t.domain] ??= []);
      let sub = rows.findIndex((lastX) => x - lastX >= MIN_GAP);
      if (sub === -1) { sub = rows.length; rows.push(x); } else rows[sub] = x;
      placed[t.id] = { x, sub };
    }
    const bandTop: Record<string, number> = {};
    let yCursor = 0;
    for (const d of domainOrder) {
      bandTop[d] = yCursor;
      yCursor += Math.max(1, subRows[d]?.length ?? 0) * ROW_H + BAND_GAP;
    }

    const elements: cytoscape.ElementDefinition[] = [];
    for (const t of data.theories) {
      elements.push({
        group: 'nodes',
        data: { id: t.id, label: t.shortTitle, kind: 'theory', domain: t.domain, rec: t },
        position: { x: placed[t.id].x, y: bandTop[t.domain] + placed[t.id].sub * ROW_H },
      });
      for (const r of t.relations)
        elements.push({ group: 'edges', data: { id: `${t.id}-${r.type}-${r.target}`, source: t.id, target: r.target, rel: r.type, note: r.note } });
    }
    // Year ticks along the top (time layout only).
    const tickYears = ticksFor(minY, maxY);
    const bandLabelElements: cytoscape.ElementDefinition[] = domainOrder
      .filter((d) => data.theories.some((t) => t.domain === d))
      .map((d) => ({
        group: 'nodes',
        data: { id: `band:${d}`, label: `${data.domains[d].label}  (${data.theories.filter((t) => t.domain === d).length})`, kind: 'band', domain: d },
        position: { x: -330, y: bandTop[d] },
        selectable: false, grabbable: false,
      }));
    const tickElements: cytoscape.ElementDefinition[] = tickYears.map((y) => ({
      group: 'nodes', data: { id: `tick:${y}`, label: String(y), kind: 'tick' }, position: { x: xFor(y), y: -70 },
      selectable: false, grabbable: false,
    }));
    elements.push(...tickElements, ...bandLabelElements);
    const timePositions = Object.fromEntries(elements.filter((e) => e.group === 'nodes').map((e) => [e.data.id, { ...e.position! }]));

    const mechUsers = new Map<string, string[]>();
    for (const t of data.theories) for (const m of t.mechanisms) mechUsers.set(m, [...(mechUsers.get(m) ?? []), t.id]);
    const mechElements: cytoscape.ElementDefinition[] = [];
    for (const m of data.mechanisms) {
      mechElements.push({ group: 'nodes', data: { id: `m:${m.id}`, label: m.title, kind: 'mechanism', rec: m } });
      for (const t of mechUsers.get(m.id) ?? [])
        mechElements.push({ group: 'edges', data: { id: `${t}->m:${m.id}`, source: t, target: `m:${m.id}`, rel: 'mechanism' } });
    }

    function style(): cytoscape.StylesheetJson {
      const ink = css('--ink'), ink2 = css('--ink-2'), line = css('--line-strong'), edge = css('--ink-3'), surface = css('--surface');
      const s: cytoscape.StylesheetJson = [
        { selector: 'node', style: {
          label: 'data(label)', 'font-size': 13, 'font-family': css('--font'), color: ink,
          'text-valign': 'bottom', 'text-margin-y': 6, 'text-wrap': 'wrap', 'text-max-width': '130px',
          'text-background-color': surface, 'text-background-opacity': 0.85, 'text-background-padding': '2px',
          width: 30, height: 30, 'border-width': 2, 'border-color': surface,
        } },
        { selector: 'node[kind="mechanism"]', style: {
          shape: 'round-rectangle', width: 14, height: 14, 'background-color': css('--surface-2'),
          'border-color': line, 'border-width': 1.5, color: ink2, 'font-size': 11, 'font-style': 'italic',
        } },
        { selector: 'node[kind="band"]', style: {
          width: 22, height: 22, 'border-width': 0, color: ink, 'font-size': 20, 'font-weight': 600,
          'text-valign': 'center', 'text-halign': 'right', 'text-margin-x': 10, 'text-wrap': 'none',
          'text-background-opacity': 0, events: 'no',
        } },
        { selector: 'node[kind="tick"]', style: {
          width: 1, height: 1, opacity: 1, 'background-opacity': 0, 'border-width': 0, color: css('--ink-3'),
          'font-size': 12, 'text-valign': 'top', 'text-background-opacity': 0, events: 'no',
        } },
        { selector: 'edge', style: {
          width: 1.5, opacity: 0.35, 'line-color': edge, 'target-arrow-color': edge, 'target-arrow-shape': 'triangle',
          'curve-style': 'bezier', 'arrow-scale': 0.9,
        } },
        { selector: 'edge[rel="challenges"]', style: { 'line-style': 'dashed', 'line-dash-pattern': [6, 4] } },
        { selector: 'edge[rel="integrates"], edge[rel="related-to"]', style: { 'line-style': 'dotted' } },
        { selector: 'edge[rel="related-to"]', style: { 'target-arrow-shape': 'none' } },
        { selector: 'edge[rel="mechanism"]', style: { width: 1, 'line-style': 'dotted', 'target-arrow-shape': 'none', opacity: 0.6 } },
        { selector: '.faded', style: { opacity: 0.15 } },
        { selector: 'node.nodata', style: { 'background-opacity': 0, 'border-color': css('--ink-3'), 'border-style': 'dashed', 'border-width': 1.5 } },
        { selector: '.off', style: { opacity: 0.07, events: 'no' } },
        { selector: 'edge.off', style: { display: 'none' } },
        { selector: 'node:selected', style: { 'border-color': css('--accent'), 'border-width': 3 } },
        { selector: 'edge.hl', style: { 'line-color': ink2, 'target-arrow-color': ink2, width: 2.5, opacity: 1 } },
      ];
      for (const [d, st] of Object.entries(data.domainStyle))
        s.push({ selector: `node[domain="${d}"]`, style: { 'background-color': css(`--d${st.slot}`), shape: st.shape as any } });
      return s;
    }

    const cy = cytoscape({
      container: document.getElementById('cy'),
      elements,
      style: style(),
      layout: { name: 'preset', fit: true, padding: 40 },
      wheelSensitivity: 0.3,
      minZoom: 0.2,
      maxZoom: 3,
    });

    const panel = document.getElementById('panel')!;
    function show(node: cytoscape.NodeSingular) {
      const rec = node.data('rec');
      cy.elements().not('node[kind="band"], node[kind="tick"]').addClass('faded');
      cy.elements().removeClass('hl');
      const hood = node.closedNeighborhood();
      hood.removeClass('faded');
      hood.edges().addClass('hl');
      if (node.data('kind') === 'mechanism') {
        panel.innerHTML = `<p class="muted" style="margin:0 0 .25rem;font-size:.8rem">Mechanism</p><h3>${esc(rec.title)}</h3><p>${esc(rec.summary)}</p><a href="${rec.url}">Open page →</a>`;
        return;
      }
      const rels = node.connectedEdges().filter((e) => e.data('rel') !== 'mechanism').map((e: cytoscape.EdgeSingular) => {
        const out = e.source().id() === node.id();
        const other = out ? e.target() : e.source();
        const rel = data.relations[e.data('rel')] as { label: string; inverse?: string };
        const label = out ? rel.label : rel.inverse ?? rel.label;
        return `<li><span class="muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">${label}</span><br><strong>${esc(other.data('label'))}</strong></li>`;
      });
      panel.innerHTML = `<p class="muted" style="margin:0 0 .25rem;font-size:.8rem">${rec.year} · ${esc(data.domains[rec.domain].label)}</p>
        <h3>${esc(rec.title)}</h3><p>${esc(rec.summary)}</p>
        <p class="muted" style="font-size:.8rem;margin:.2rem 0 .6rem">Citations of founding work(s): ${(data as any).sizes[rec.id].citationsN === null ? 'unknown' : '≈ ' + (data as any).sizes[rec.id].citationsN.toLocaleString('en-US')} · Influence on this map: ${(data as any).sizes[rec.id].influenceN}</p>
        ${rels.length ? `<ul style="padding-left:1.1rem">${rels.join('')}</ul>` : ''}
        <a href="${rec.url}">Open page →</a>`;
    }
    cy.on('tap', 'node[kind="theory"], node[kind="mechanism"]', (e) => show(e.target));
    cy.on('dbltap', 'node[kind="theory"], node[kind="mechanism"]', (e) => { location.href = e.target.data('rec').url; });
    cy.on('tap', (e) => {
      if (e.target === cy) {
        cy.elements().removeClass('faded hl');
        panel.innerHTML = '<p class="muted" style="margin:0">Select a node to see details.</p>';
      }
    });

    const layoutSel = document.getElementById('layout') as HTMLSelectElement;
    const mechBox = document.getElementById('show-mech') as HTMLInputElement;
    function relayout() {
      cy.remove('node[kind="tick"], node[kind="band"]');
      if (layoutSel.value === 'time' && !mechBox.checked) {
        cy.add([...tickElements, ...bandLabelElements]);
        cy.nodes().forEach((n) => { if (timePositions[n.id()]) n.position(timePositions[n.id()]); });
        cy.fit(undefined, 40);
      } else {
        cy.layout({
          name: 'cose', animate: false, randomize: true, padding: 40, numIter: 2500,
          nodeRepulsion: () => 120000, idealEdgeLength: () => 150, nodeOverlap: 40, gravity: 0.3, componentSpacing: 120,
        } as any).run();
      }
    }
    layoutSel.addEventListener('change', relayout);
    mechBox.addEventListener('change', () => {
      if (mechBox.checked) cy.add(mechElements);
      else cy.remove('node[kind="mechanism"]');
      if (mechBox.checked && layoutSel.value === 'time') layoutSel.value = 'force';
      relayout();
    });
    document.getElementById('fit')!.addEventListener('click', () => {
      cy.elements().removeClass('faded hl');
      cy.fit(undefined, 40);
    });
    window.addEventListener('themechange', () => cy.style(style()));
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => cy.style(style()));

    // Type / scope filter: fade non-matching theories and hide their links.
    let currentFilter: MapFilter = { kinds: [], questions: [] };
    function applyFilter() {
      const f = currentFilter;
      let shown = 0, total = 0;
      cy.nodes('[kind="theory"]').forEach((n) => {
        total++;
        const r = n.data('rec');
        const ok = matchesFilter(r.kind, r.questions, f);
        n.toggleClass('off', !ok);
        if (ok) shown++;
      });
      cy.nodes('[kind="mechanism"]').forEach((m) => {
        m.toggleClass('off', m.neighborhood('node[kind="theory"]').filter((n) => !n.hasClass('off')).empty());
      });
      cy.edges().forEach((e) => { e.toggleClass('off', e.source().hasClass('off') || e.target().hasClass('off')); });
      window.dispatchEvent(new CustomEvent('mapfilter:count', { detail: { shown, total } }));
    }
    window.addEventListener('mapfilter', (e) => { currentFilter = (e as CustomEvent<MapFilter>).detail; applyFilter(); });

    // Marker size by citations / influence (SizeToggle emits 'mapsize').
    const SIZES = (data as any).sizes as Record<string, { citations: number | null; influence: number }>;
    let sizeMode = 'equal';
    function applySize() {
      cy.batch(() => {
        cy.nodes('[kind="theory"]').forEach((n) => {
          const sc = SIZES[n.id()];
          const v = sizeMode === 'citations' ? sc.citations : sizeMode === 'influence' ? sc.influence : 1;
          const d = 30 * (v ?? 0.55);
          n.style({ width: d, height: d });
          n.toggleClass('nodata', sizeMode === 'citations' && v === null);
        });
      });
    }
    window.addEventListener('mapsize', (e) => { sizeMode = (e as CustomEvent<{ mode: string }>).detail.mode; applySize(); });
    // Re-apply after mechanisms are added/removed.
    mechBox.addEventListener('change', () => applyFilter());

    const focus = new URLSearchParams(location.search).get('focus');
    if (focus && cy.getElementById(focus).nonempty()) {
      const n = cy.getElementById(focus);
      n.select();
      show(n);
    }
  </script>
</Base>
