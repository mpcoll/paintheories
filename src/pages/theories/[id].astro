---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import Notice from '../../components/Notice.astro';
import EvidenceTable from '../../components/EvidenceTable.astro';
import TheoryDiagram from '../../components/TheoryDiagram.astro';
import { getTheories, url, cite, formatReference, resolveRefs, type Theory, type Mechanism } from '../../lib/data';
import { KINDS, LEVELS, QUESTIONS, PAIN_TYPES, STATUSES, RELATIONS } from '../../data/taxonomy';

export async function getStaticPaths() {
  const theories = await getTheories();
  return theories.map((theory) => ({ params: { id: theory.id }, props: { theory, all: theories } }));
}

const { theory, all } = Astro.props as { theory: Theory; all: Theory[] };
const d = theory.data;
const { Content } = await render(theory);
const byId = new Map(all.map((t) => [t.id, t]));

const outgoing = d.relations.map((r) => ({ ...r, other: byId.get(r.target.id)! }));
const incoming = all.flatMap((t) =>
  t.data.relations.filter((r) => r.target.id === theory.id).map((r) => ({ ...r, other: t })),
);
const mechanisms = d.mechanisms.length ? ((await getEntries(d.mechanisms)) as Mechanism[]) : [];
const foundational = await resolveRefs(d.foundational);
const foundIds = new Set(d.foundational.map((r) => r.id));
const otherIds = [...new Set([...d.keyReferences, ...d.evidence.flatMap((e) => e.refs)].map((r) => r.id))].filter((id) => !foundIds.has(id));
const keyRefs = (await resolveRefs(otherIds.map((id) => ({ id, collection: 'references' })))).sort(
  (a, b) => a.data.authors[0].localeCompare(b.data.authors[0]) || a.data.year - b.data.year,
);
const openQuestions = (await getCollection('gaps'))
  .filter((g) => g.data.predictions.some((p) => p.theory.id === theory.id))
  .sort((a, b) => a.data.order - b.data.order);
const reviewLabel = { stub: 'Stub — only the basic facts are filled in.', draft: 'Draft — not yet reviewed by a domain expert.', reviewed: '' }[d.review];
---

<Base title={d.title} description={d.summary}>
  <p class="crumbs"><a href={url('theories/')}>Pain Theories</a> / <a href={url('theories/all/')}>All theories</a> / {KINDS[d.kind].label}</p>
  <header class={`theory-head d-${d.domain}`}>
    <p class="eyebrow">{d.year} · {d.proponents.slice(0, 3).join(', ')}{d.proponents.length > 3 ? ' et al.' : ''}</p>
    <h1>{d.title}</h1>
    {d.aliases.length > 0 && <p class="aka">Also known as {d.aliases.join('; ')}</p>}
    <p class="lede">{d.summary}</p>
    <div class="tags">
      <DomainBadge domain={d.domain} />
      <span class="tag">{KINDS[d.kind].label}</span>
      <span class="tag" title={STATUSES[d.status].description}>Status: {STATUSES[d.status].label}</span>
    </div>
  </header>
  {reviewLabel && <div data-pagefind-ignore><Notice>{reviewLabel} Spotted an error? <a href={`https://github.com/mpcoll/paintheories/issues/new?title=${encodeURIComponent('Correction: ' + d.title)}`}>Report it on GitHub</a>.</Notice></div>}

  <div class="theory-layout">
    <article class={`prose article d-${d.domain}`}>
      <TheoryDiagram theory={theory} />
      <h2>Core claims</h2>
      <ol class="claims">{d.coreClaims.map((c) => <li>{c}</li>)}</ol>
      {
        d.predictions.length > 0 && (
          <>
            <h2>Testable predictions</h2>
            <ul class="claims">{d.predictions.map((p) => <li>{p}</li>)}</ul>
          </>
        )
      }
      <EvidenceTable evidence={d.evidence} />
      <Content />

      <h2 id="references">References</h2>
      <h3>Foundational</h3>
      <ul class="refs">
        {foundational.map((r) => { const f = formatReference(r.data); return <li>{f.text} {f.doiUrl && <a class="doi" href={f.doiUrl}>DOI ↗</a>}</li>; })}
      </ul>
      {keyRefs.length > 0 && <>
        <h3>Reviews, tests and critiques</h3>
        <ul class="refs">
          {keyRefs.map((r) => { const f = formatReference(r.data); return <li>{f.text} {f.doiUrl && <a class="doi" href={f.doiUrl}>DOI ↗</a>}</li>; })}
        </ul>
      </>}
      <p class="muted" style="font-size:.85rem">Last updated {d.updated.toISOString().slice(0, 10)} · <a href={`https://github.com/mpcoll/paintheories/blob/main/src/content/theories/${theory.id}.md`}>View source</a></p>
    </article>

    <aside class="side" data-pagefind-ignore>
      <section class="card">
        <h2>At a glance</h2>
        <dl class="facts">
          <dt>Proposed</dt><dd>{d.year}</dd>
          <dt>Proponents</dt><dd>{d.proponents.join(', ')}</dd>
          <dt>Levels</dt><dd>{d.levels.map((l) => LEVELS[l].label).join(', ')}</dd>
          <dt>Explains</dt><dd>{d.questions.map((q) => QUESTIONS[q].label).join(' ')}</dd>
          <dt>Pain types</dt><dd>{d.painTypes.map((p) => PAIN_TYPES[p].label).join(', ')}</dd>
          <dt>Key papers</dt>
          <dd class="keypapers">
            {foundational.map((r) => (
              <a href={r.data.doi ? `https://doi.org/${r.data.doi}` : url(`references/#${r.id}`)} title={r.data.title}>
                {cite(r)}{r.data.doi && <span aria-hidden="true"> ↗</span>}
              </a>
            ))}
          </dd>
        </dl>
      </section>
      {(outgoing.length > 0 || incoming.length > 0) && (
        <section class="card">
          <h2>Relations</h2>
          <ul>
            {outgoing.map((r) => <li><span class="rel-type">{RELATIONS[r.type].label}</span><a href={url(`theories/${r.other.id}/`)}>{r.other.data.shortTitle ?? r.other.data.title}</a>{r.note && <span class="note">{r.note}</span>}</li>)}
            {incoming.map((r) => <li><span class="rel-type">{RELATIONS[r.type].inverse}</span><a href={url(`theories/${r.other.id}/`)}>{r.other.data.shortTitle ?? r.other.data.title}</a></li>)}
          </ul>
          <a class="more" href={url(`theories/map/?focus=${theory.id}`)}>Show on map →</a>
        </section>
      )}
      {mechanisms.length > 0 && (
        <section class="card">
          <h2>Mechanisms invoked</h2>
          <ul>{mechanisms.map((m) => <li><a href={url(`mechanisms/${m.id}/`)}>{m.data.title}</a></li>)}</ul>
        </section>
      )}
      {openQuestions.length > 0 && (
        <section class="card">
          <h2>Open questions</h2>
          <ul>{openQuestions.map((g) => <li><a href={url(`theories/gaps/#${g.id}`)}>{g.data.title}</a></li>)}</ul>
        </section>
      )}
      <section class="card">
        <h2>Compare</h2>
        <p style="margin:0;font-size:.9rem;color:var(--ink-2)">See this theory side by side with others.</p>
        <a class="more" href={url(`theories/compare/?ids=${theory.id}`)}>Open comparison →</a>
      </section>
    </aside>
  </div>
</Base>
