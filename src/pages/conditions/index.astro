---
import Base from '../../layouts/Base.astro';
import BodyMap from '../../components/BodyMap.astro';
import DescriptorPills from '../../components/DescriptorPills.astro';
import { url } from '../../lib/data';
import { getConditions, categoriesOf, descriptorProfile, conditionUrl, DESC_ORDER, ROLE_ORDER, CATEGORY_ORDER, FAMILY_ORDER, REGION_ORDER, type Condition } from '../../lib/conditions';
import { FAMILIES, ICD_CATEGORIES, DESCRIPTORS, DESCRIPTOR_ROLES, icdCategoryOf } from '../../data/conditions-taxonomy';

const conditions = await getConditions();
const counts = Object.fromEntries(REGION_ORDER.map((r) => [r, conditions.filter((c) => c.data.regions.includes(r)).length]));
const firstSentence = (s: string) => (s.match(/^.+?[.!?](\s|$)/)?.[0] ?? s).trim();
const attrs = (c: Condition) => ({
  'data-regions': c.data.regions.join(' '),
  'data-desc': DESC_ORDER.filter((t) => descriptorProfile(c)[t]).join(' '),
});

const byFamily = FAMILY_ORDER.map((f) => ({ key: f, items: conditions.filter((c) => c.data.family === f) })).filter((g) => g.items.length);
const byCategory = CATEGORY_ORDER.map((cat) => ({
  key: cat,
  items: conditions
    .filter((c) => categoriesOf(c).includes(cat))
    .map((c) => ({ c, codes: c.data.icd.pain.filter((p) => icdCategoryOf(p.code) === cat) })),
})).filter((g) => g.items.length);
const byDescriptor = DESC_ORDER.map((t) => ({
  key: t,
  items: conditions
    .map((c) => ({ c, role: descriptorProfile(c)[t] }))
    .filter((x) => x.role)
    .sort((a, b) => ROLE_ORDER.indexOf(a.role!) - ROLE_ORDER.indexOf(b.role!) || a.c.data.title.localeCompare(b.c.data.title)),
}));
const nPrimary = conditions.filter((c) => categoriesOf(c).includes('MG30.0')).length;
---

<Base title="Pain conditions" description="Chronic pain conditions seen through three lenses: traditional clinical families, the ICD-11 chronic pain classification and the IASP mechanistic descriptors (nociceptive, neuropathic, nociplastic).">
  <header class="page-head">
    <p class="eyebrow">Pain Conditions</p>
    <h1>Chronic pain conditions</h1>
    <p class="lede">{conditions.length} chronic pain conditions, each classified three ways: by the traditional clinical family, by the ICD-11 chronic pain codes, and by the IASP mechanistic descriptors. Switch lenses to see how the same conditions regroup.</p>
  </header>

  <div class="cx" id="cx" data-lens="family">
    <aside class="cx-side" data-pagefind-ignore>
      <section class="card">
        <h2 class="side-h">Where it hurts</h2>
        <BodyMap mode="filter" counts={counts} id="cx-body" />
      </section>
      <section class="card">
        <h2 class="side-h">Mechanism</h2>
        <div class="cx-desc" role="group" aria-label="Filter by mechanistic descriptor">
          <button type="button" class="chip" data-desc="" aria-pressed="true">Any</button>
          {DESC_ORDER.map((t) => <button type="button" class={`chip dchip desc-${t}`} data-desc={t} aria-pressed="false"><span class="dsw" aria-hidden="true"></span>{DESCRIPTORS[t].label}</button>)}
        </div>
        <p class="side-note">Includes conditions where the mechanism is defining, common or found in a subset.</p>
      </section>
    </aside>

    <div class="cx-main">
      <div class="cx-bar" data-pagefind-ignore>
        <div class="lens" role="tablist" aria-label="Classification lens">
          <button type="button" role="tab" data-lens="family" aria-selected="true">Traditional</button>
          <button type="button" role="tab" data-lens="icd" aria-selected="false">ICD-11</button>
          <button type="button" role="tab" data-lens="desc" aria-selected="false">Mechanism (IASP)</button>
        </div>
        <p class="cx-count" aria-live="polite"><span class="n">{conditions.length}</span> of {conditions.length} conditions</p>
      </div>

      <section class="view" data-view="family">
        <p class="view-intro">Grouped as clinicians and textbooks usually group them: by body region and specialty.</p>
        {byFamily.map((g) => (
          <div class="grp">
            <h2>{FAMILIES[g.key].label}</h2>
            <p class="grp-d">{FAMILIES[g.key].description}</p>
            <div class="cards">
              {g.items.map((c) => (
                <a class="cc card" href={conditionUrl(c.id)} {...attrs(c)}>
                  <h3>{c.data.title}</h3>
                  <p>{firstSentence(c.data.summary)}</p>
                  <p class="cc-codes">{[...new Set(c.data.icd.pain.map((p) => p.code))].join(' · ')}</p>
                  <DescriptorPills condition={c} compact />
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section class="view" data-view="icd" hidden>
        <p class="view-intro">Grouped by the ICD-11 chronic pain code (MG30). {nPrimary} conditions can be coded as <strong>chronic primary pain</strong>, a condition in its own right; the rest are <strong>chronic secondary pain</strong>, a symptom of an underlying disease. A condition appears more than once when its code depends on the case. <a href={url('conditions/classification/')}>How ICD-11 classifies chronic pain →</a></p>
        {byCategory.map((g) => (
          <div class={`grp icd-${ICD_CATEGORIES[g.key].kind}`}>
            <h2><span class="code">{g.key}</span> {ICD_CATEGORIES[g.key].label} <span class="kind">{ICD_CATEGORIES[g.key].kind}</span></h2>
            <p class="grp-d">{ICD_CATEGORIES[g.key].description}</p>
            <div class="cards">
              {g.items.map(({ c, codes }) => (
                <a class="cc card" href={conditionUrl(c.id)} {...attrs(c)}>
                  <h3>{c.data.title}</h3>
                  {codes.map((p) => <p class="cc-code"><span class="code">{p.code}</span> {p.title}</p>)}
                  {codes.some((p) => p.when) && <p class="cc-when">{codes.filter((p) => p.when).map((p) => p.when).join(' ')}</p>}
                  <DescriptorPills condition={c} compact />
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section class="view" data-view="desc" hidden>
        <p class="view-intro">Grouped by the IASP mechanistic descriptors. Most conditions involve more than one mechanism, so they appear in several groups, ordered from defining to in a subset. <a href={url('conditions/descriptors/')}>Nociceptive, neuropathic, nociplastic →</a></p>
        {byDescriptor.map((g) => (
          <div class={`grp desc-${g.key}`}>
            <h2><span class="dsw" aria-hidden="true"></span>{DESCRIPTORS[g.key].label}</h2>
            <p class="grp-d">{DESCRIPTORS[g.key].description}</p>
            <div class="cards">
              {g.items.map(({ c, role }) => (
                <a class="cc card" href={conditionUrl(c.id)} {...attrs(c)}>
                  <h3>{c.data.title}</h3>
                  <p class={`cc-role role-${role}`}>{DESCRIPTOR_ROLES[role!].label}</p>
                  <p>{c.data.descriptors.find((x) => x.type === g.key)?.note}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
      <p class="cx-empty" hidden>No condition matches these filters.</p>
    </div>
  </div>

  <style>
    .cx { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 2rem; align-items: start; }
    @media (max-width: 860px) { .cx { grid-template-columns: 1fr; } }
    .cx-side { display: grid; gap: 1rem; position: sticky; top: 128px; }
    @media (max-width: 860px) { .cx-side { position: static; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); } }
    .side-h { font: 600 .72rem var(--font); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin: 0 0 .6rem; }
    .side-note { font-size: .8rem; color: var(--ink-3); margin: .6rem 0 0; }
    .cx-desc { display: flex; flex-wrap: wrap; gap: .35rem; }
    .chip { font: 500 .84rem var(--font); color: var(--ink-2); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 999px; padding: .3rem .75rem; cursor: pointer; display: inline-flex; align-items: center; gap: .4rem; }
    .chip:hover { border-color: var(--ink-3); color: var(--ink); }
    .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
    .dsw { display: inline-block; width: 11px; height: 11px; border-radius: 3px; background: var(--c); margin-right: .1rem; flex: none; }
    .desc-nociceptive { --c: var(--desc-noc); }
    .desc-neuropathic { --c: var(--desc-neu); }
    .desc-nociplastic { --c: var(--desc-npl); }
    .cx-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1rem; margin-bottom: 1rem; position: sticky; top: 112px; z-index: 2; background: var(--bg); padding: .4rem 0; }
    @media (max-width: 860px) { .cx-bar { position: static; } }
    .lens { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 10px; overflow: hidden; background: var(--surface); }
    .lens button { font: 600 .88rem var(--font); border: 0; background: transparent; color: var(--ink-2); padding: .5rem .95rem; cursor: pointer; }
    .lens button + button { border-left: 1px solid var(--line-strong); }
    .lens button[aria-selected='true'] { background: var(--ink); color: var(--bg); }
    .cx-count { margin: 0; font-size: .85rem; color: var(--ink-3); }
    .view-intro { color: var(--ink-2); max-width: var(--measure); margin: 0 0 1.2rem; }
    .grp { margin-bottom: 1.8rem; }
    .grp h2 { font-size: 1.3rem; margin: 0 0 .2rem; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .grp-d { color: var(--ink-3); font-size: .9rem; margin: 0 0 .7rem; max-width: var(--measure); }
    .grp .code, .cc-code .code { font: 600 .82em var(--mono); color: var(--ink-2); }
    .grp .kind { font: 600 .68rem var(--font); text-transform: uppercase; letter-spacing: .08em; padding: .15rem .45rem; border-radius: 6px; border: 1px solid var(--line-strong); color: var(--ink-3); }
    .icd-primary .kind { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .8rem; }
    .cc { display: flex; flex-direction: column; gap: .4rem; text-decoration: none; color: inherit; padding: .9rem 1rem; transition: box-shadow .15s, transform .15s; }
    .cc:hover { box-shadow: var(--shadow-lift); transform: translateY(-1px); }
    .cc h3 { margin: 0; font-size: 1.05rem; }
    .cc p { margin: 0; font-size: .86rem; color: var(--ink-2); }
    .cc-codes { font: .78rem var(--mono) !important; color: var(--ink-3) !important; }
    .cc-code { font-size: .82rem !important; }
    .cc-when { font-size: .78rem !important; color: var(--ink-3) !important; font-style: italic; }
    .cc-role { font: 600 .7rem var(--font) !important; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-3) !important; }
    .cc[hidden], .grp[hidden] { display: none; }
    .cx-empty { color: var(--ink-3); }
  </style>

  <script>
    const root = document.getElementById('cx')!;
    let lens = 'family', region: string | null = null, desc = '';
    const params = () => {
      const p = new URLSearchParams();
      if (lens !== 'family') p.set('lens', lens);
      if (region) p.set('region', region);
      if (desc) p.set('desc', desc);
      history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
    };
    function apply() {
      root.dataset.lens = lens;
      root.querySelectorAll<HTMLButtonElement>('.lens [data-lens]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.lens === lens)));
      root.querySelectorAll<HTMLElement>('.view').forEach((v) => (v.hidden = v.dataset.view !== lens));
      const view = root.querySelector<HTMLElement>(`.view[data-view="${lens}"]`)!;
      const shown = new Set<string>();
      view.querySelectorAll<HTMLElement>('.cc').forEach((c) => {
        const regs = (c.dataset.regions ?? '').split(' ');
        const ok = (!region || regs.includes(region) || regs.includes('widespread')) && (!desc || (c.dataset.desc ?? '').split(' ').includes(desc));
        c.hidden = !ok;
        if (ok) shown.add(c.getAttribute('href')!);
      });
      view.querySelectorAll<HTMLElement>('.grp').forEach((g) => (g.hidden = !g.querySelector('.cc:not([hidden])')));
      root.querySelector('.cx-count .n')!.textContent = String(shown.size);
      (root.querySelector('.cx-empty') as HTMLElement).hidden = shown.size > 0;
      params();
    }
    root.querySelectorAll<HTMLButtonElement>('.lens [data-lens]').forEach((b) => b.addEventListener('click', () => { lens = b.dataset.lens!; apply(); }));
    root.querySelectorAll<HTMLButtonElement>('.cx-desc [data-desc]').forEach((b) => b.addEventListener('click', () => {
      desc = b.dataset.desc!;
      root.querySelectorAll('.cx-desc [data-desc]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    root.addEventListener('bodyregion', (e) => { region = (e as CustomEvent).detail; apply(); });
    const init = new URLSearchParams(location.search);
    if (['icd', 'desc'].includes(init.get('lens') ?? '')) lens = init.get('lens')!;
    const d0 = init.get('desc');
    if (d0) root.querySelector<HTMLButtonElement>(`.cx-desc [data-desc="${d0}"]`)?.click();
    const r0 = init.get('region');
    if (r0) (document.getElementById('cx-body') as any)?.setRegion?.(r0);
    apply();
  </script>
</Base>
