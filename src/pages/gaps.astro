---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Notice from '../components/Notice.astro';
import { getTheories, getReferences, cite, url } from '../lib/data';
import { DOMAINS, DOMAIN_STYLE, QUESTIONS, PAIN_TYPES } from '../data/taxonomy';

const theories = await getTheories();
const byId = new Map(theories.map((t) => [t.id, t]));
const refs = new Map((await getReferences()).map((r) => [r.id, r]));
const gaps = (await getCollection('gaps')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(gaps.map(async (g) => ({ g, Content: (await render(g)).Content })));

// ---- Data-driven gaps, computed from the theory records ----
const CLINICAL = new Set(['clinical', 'longitudinal', 'intervention', 'meta-analysis']);
const noContra = theories.filter((t) => t.data.evidence.length && !t.data.evidence.some((e) => e.direction === 'contradicts'));
const labOnly = theories.filter((t) => !t.data.evidence.some((e) => e.method && CLINICAL.has(e.method)));
const thin = theories.filter((t) => t.data.evidence.length < 4);

const domains = Object.keys(DOMAINS) as (keyof typeof DOMAINS)[];
const questions = Object.keys(QUESTIONS) as (keyof typeof QUESTIONS)[];
const cell = (q: string, d: string) => theories.filter((t) => t.data.domain === d && (t.data.questions as string[]).includes(q));
const maxCell = Math.max(...questions.flatMap((q) => domains.map((d) => cell(q, d).length)));
const painTypeCounts = (Object.keys(PAIN_TYPES) as (keyof typeof PAIN_TYPES)[]).map((p) => ({
  p, n: theories.filter((t) => (t.data.painTypes as string[]).includes(p)).length,
}));
const name = (id: string) => byId.get(id)?.data.shortTitle ?? byId.get(id)?.data.title ?? id;
---

<Base title="Gaps" description="Main open questions in pain theory, with competing testable predictions and studies that could decide between them.">
  <header class="page-head">
    <p class="eyebrow">Research agenda</p>
    <h1>Gaps and testable predictions</h1>
    <p class="lede">Open questions where theories on the map make competing predictions, with a study design that could decide between them. Below them is an automatic analysis of where the map's own evidence is thin.</p>
  </header>

  <Notice>Predictions are derived by the map's editors from each theory's core claims; proponents might state them differently. These are proposals for discussion, not settled readings of the theories.</Notice>

  <nav class="toc card" aria-label="Open questions">
    <p class="eyebrow" style="margin-bottom:.5rem">Main open questions</p>
    <ol>
      {gaps.map((g) => <li><a href={`#${g.id}`}>{g.data.title}</a></li>)}
      <li><a href="#evidence-gaps">Where the evidence is thin (automatic analysis)</a></li>
    </ol>
  </nav>

  {rendered.map(({ g, Content }, i) => (
    <section class="gap" id={g.id}>
      <p class="gap-num">Open question {i + 1}</p>
      <h2>{g.data.title}</h2>
      <p class="gap-sum">{g.data.summary}</p>
      <div class="tags">{g.data.questions.map((q) => <span class="tag">{QUESTIONS[q].label}</span>)}</div>

      <h3>Competing predictions</h3>
      <div class="table-wrap">
        <table class="preds">
          <thead><tr><th style="width:26%">Theory</th><th>Predicts</th></tr></thead>
          <tbody>
            {g.data.predictions.map((p) => {
              const t = byId.get(p.theory.id)!;
              return (
                <tr>
                  <td>
                    <span class={`dom dom-${t.data.domain}`} aria-hidden="true">{DOMAIN_STYLE[t.data.domain].symbol}</span>{' '}
                    <a href={url(`theories/${t.id}/`)}>{t.data.shortTitle ?? t.data.title}</a>
                  </td>
                  <td>{p.prediction}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="test">
        <div class="card">
          <h3>A study that could decide</h3>
          <p>{g.data.test.design}</p>
        </div>
        <div class="card">
          <h3>What would be decisive</h3>
          <p>{g.data.test.decisive}</p>
        </div>
      </div>

      <div class="prose gap-body"><Content /></div>

      <p class="gap-actions">
        <a class="btn" href={url(`compare/?ids=${g.data.predictions.slice(0, 4).map((p) => p.theory.id).join(',')}`)}>Compare these theories</a>
        <span class="muted gap-refs">Key papers: {g.data.references.map((r, j) => {
          const ref = refs.get(r.id)!;
          return <>{j > 0 && ' · '}<a href={ref.data.doi ? `https://doi.org/${ref.data.doi}` : url(`references/#${r.id}`)} title={ref.data.title}>{cite(ref)}</a></>;
        })}</span>
      </p>
    </section>
  ))}

  <section id="evidence-gaps" class="auto">
    <p class="gap-num">Automatic analysis</p>
    <h2>Where the evidence on this map is thin</h2>
    <p class="muted" style="max-width:var(--measure)">Computed from the structured entries every time the site is built. It reflects what has been curated on this map, not the whole literature, but it points to theories and questions that deserve attention.</p>

    <h3>Coverage: which questions each domain addresses</h3>
    <p class="muted" style="font-size:.9rem;margin-top:0">Number of theories in each domain that address each question. Empty and near-empty cells are candidate gaps in theory, not just in evidence.</p>
    <div class="table-wrap">
      <table class="heat">
        <thead><tr><th>Question</th>{domains.map((d) => <th><span class={`dom dom-${d}`} aria-hidden="true">{DOMAIN_STYLE[d].symbol}</span> {DOMAINS[d].label}</th>)}</tr></thead>
        <tbody>
          {questions.map((q) => (
            <tr>
              <th scope="row">{QUESTIONS[q].label}</th>
              {domains.map((d) => {
                const list = cell(q, d);
                const pct = list.length ? 10 + Math.round((list.length / maxCell) * 60) : 0;
                return (
                  <td class={list.length === 0 ? 'zero' : ''} style={list.length ? `background: color-mix(in srgb, var(--d1) ${pct}%, var(--surface))` : ''} title={list.map((t) => t.data.title).join(', ') || 'No theories'}>
                    {list.length || '—'}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="auto-grid">
      <div class="card">
        <h3>No contradicting finding documented ({noContra.length})</h3>
        <p class="muted">Either untested by critical studies or not yet curated. A theory that has never failed a test is not yet well tested.</p>
        <ul class="tlist">{noContra.map((t) => <li><a href={url(`theories/${t.id}/#key-findings`)}>{name(t.id)}</a> <span class="muted">({t.data.evidence.length} findings)</span></li>)}</ul>
      </div>
      <div class="card">
        <h3>No clinical, longitudinal or trial evidence ({labOnly.length})</h3>
        <p class="muted">All documented findings come from laboratory, animal, imaging, genetic or modelling studies, so the theory's relevance to people with pain is untested here.</p>
        <ul class="tlist">{labOnly.map((t) => <li><span class={`dom dom-${t.data.domain}`} title={DOMAINS[t.data.domain].label} aria-label={DOMAINS[t.data.domain].label}>{DOMAIN_STYLE[t.data.domain].symbol}</span> <a href={url(`theories/${t.id}/#key-findings`)}>{name(t.id)}</a></li>)}</ul>
      </div>
      <div class="card">
        <h3>Thin evidence base ({thin.length})</h3>
        <p class="muted">Fewer than four documented findings.</p>
        <ul class="tlist">{thin.map((t) => <li><a href={url(`theories/${t.id}/#key-findings`)}>{name(t.id)}</a> <span class="muted">({t.data.evidence.length})</span></li>)}</ul>
        <h3 style="margin-top:1.25rem">Pain types addressed</h3>
        <p class="muted">Number of theories addressing each type. Few theories are specific to nociceptive, neuropathic or nociplastic pain.</p>
        <ul class="tlist">{painTypeCounts.map(({ p, n }) => <li>{PAIN_TYPES[p].label}: <strong>{n}</strong></li>)}</ul>
      </div>
    </div>
  </section>

  <p class="muted" style="font-size:.85rem;margin-top:2rem">Download the open questions as <a href={url('data/gaps.json')}>gaps.json</a>. Suggestions for new open questions are welcome on <a href="https://github.com/mpcoll/paintheories/issues">GitHub</a>.</p>

  <style>
    .toc ol { margin: 0; padding-left: 1.3rem; display: grid; gap: .3rem; }
    .toc { margin: 1.5rem 0 1rem; max-width: 860px; }
    .gap { padding-top: 2.5rem; margin-top: 2.5rem; border-top: 1px solid var(--line); }
    .gap h2 { margin-top: .2rem; max-width: 30ch; font-size: 1.7rem; }
    .gap-num { font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: 0; }
    .gap-sum { font-size: 1.08rem; color: var(--ink-2); max-width: var(--measure); }
    .preds td:first-child { white-space: nowrap; font-weight: 500; }
    @media (max-width: 640px) { .preds td:first-child { white-space: normal; } }
    .test { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; margin-top: 1rem; }
    .test h3 { margin: 0 0 .4rem; font-size: 1rem; }
    .test p { margin: 0; font-size: .95rem; }
    .gap-body :global(h2) { font-size: 1.1rem; margin-top: 1.5rem; }
    .gap-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; }
    .gap-refs { font-size: .85rem; }
    .gap-refs a { text-decoration: none; }
    .auto { padding-top: 2.5rem; margin-top: 3rem; border-top: 2px solid var(--line-strong); }
    .heat th, .heat td { text-align: center; }
    .heat th[scope='row'] { text-align: left; white-space: nowrap; }
    .heat td { font-weight: 600; font-variant-numeric: tabular-nums; }
    .heat td.zero { color: var(--ink-3); background: repeating-linear-gradient(135deg, var(--surface), var(--surface) 4px, var(--surface-2) 4px, var(--surface-2) 8px); }
    .auto-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.5rem; align-items: start; }
    .auto-grid h3 { margin: 0 0 .3rem; font-size: 1.05rem; }
    .auto-grid p { font-size: .88rem; margin: 0 0 .6rem; }
    .tlist { margin: 0; padding-left: 1.1rem; font-size: .9rem; display: grid; gap: .25rem; }
  </style>
</Base>
