---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TheoryCard from '../components/TheoryCard.astro';
import { getTheories, url } from '../lib/data';
import { DOMAINS } from '../data/taxonomy';

const theories = await getTheories();
const mechanisms = await getCollection('mechanisms');
const references = await getCollection('references');
const relations = theories.reduce((n, t) => n + t.data.relations.length, 0);
const byDomain = Object.entries(DOMAINS).map(([k, v]) => ({ k, label: v.label, n: theories.filter((t) => t.data.domain === k).length }));
const recent = [...theories].sort((a, b) => b.data.year - a.data.year).slice(0, 3);
---
<Base title="Pain Theories Map">
  <section style="padding:1rem 0 1.5rem">
    <h1>A structured map of pain theories</h1>
    <p class="lede">From Descartes to predictive processing: every major scientific theory and model of pain, described in a common format and linked to the mechanisms it invokes, the theories it builds on or challenges, and the evidence for and against it.</p>
    <p style="display:flex;gap:.5rem;flex-wrap:wrap">
      <a class="btn" href={url('map/')}>Explore the map</a>
      <a class="btn" href={url('theories/')}>Browse all theories</a>
      <a class="btn" href={url('compare/?ids=gate-control-theory,neuromatrix-theory,predictive-processing')}>Compare theories</a>
    </p>
  </section>

  <section class="grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-bottom:2rem">
    <div class="card"><div style="font-size:2rem;font-weight:700">{theories.length}</div><div class="muted">theories and models</div></div>
    <div class="card"><div style="font-size:2rem;font-weight:700">{relations}</div><div class="muted">relations between them</div></div>
    <div class="card"><div style="font-size:2rem;font-weight:700">{mechanisms.length}</div><div class="muted">mechanisms</div></div>
    <div class="card"><div style="font-size:2rem;font-weight:700">{references.length}</div><div class="muted">references</div></div>
  </section>

  <p class="notice">This map is under construction. Current entries are drafts and are being reviewed; the list of theories will expand substantially.</p>

  <h2>By domain</h2>
  <ul>
    {byDomain.map((d) => <li><a href={url(`theories/?domain=${d.k}`)}>{d.label}</a> <span class="muted">({d.n})</span></li>)}
  </ul>

  <h2>Most recent proposals</h2>
  <div class="grid">{recent.map((t) => <TheoryCard theory={t} />)}</div>
</Base>
