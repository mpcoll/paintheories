---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/data';

const theories = await getCollection('theories');
const mechanisms = await getCollection('mechanisms');
const circuitStations = await getCollection('circuitStations');
const gaps = await getCollection('gaps');
const findings = theories.reduce((n, t) => n + t.data.evidence.length, 0);

type Module = {
  name: string;
  href?: string;
  status: 'live' | 'early' | 'planned';
  blurb: string;
  stats?: string[];
  icon: string; // SVG path data, 24×24
};
const modules: Module[] = [
  {
    name: 'Pain Theories',
    href: 'theories/',
    status: 'live',
    blurb: 'Scientific theories and models of pain in a common format, linked to the mechanisms they invoke, the evidence for and against them, and the open questions they raise.',
    stats: [`${theories.length} theories`, `${findings} key findings`, `${gaps.length} open questions`],
    icon: 'M5 19 L11 7 L19 12 M5 19 L19 12',
  },
  {
    name: 'Pain Biology',
    href: 'biology/',
    status: 'early',
    blurb: 'Pain circuits from the spinal cord to the cortex, shown in 3D in the Planum brain atlas, plus the mechanisms that theories invoke.',
    stats: [`${circuitStations.length} circuit stations`, `${mechanisms.length} mechanisms`],
    icon: 'M12 3 C8 7 8 11 12 13 C16 15 16 19 12 21 M8 6 H16 M8 18 H16 M7 12 H17',
  },
  {
    name: 'Pain Treatments',
    status: 'planned',
    blurb: 'Pharmacological, interventional, psychological and physical treatments, linked to their mechanisms of action and to the theories that motivate them.',
    icon: 'M10 4 H14 V10 H20 V14 H14 V20 H10 V14 H4 V10 H10 Z',
  },
  {
    name: 'Pain Conditions',
    status: 'planned',
    blurb: 'Fibromyalgia, CRPS, low back pain, neuropathic pain and others, with the mechanisms and theories proposed to explain each.',
    icon: 'M4 6 H20 M4 12 H20 M4 18 H14',
  },
  {
    name: 'Pain Assessment',
    status: 'planned',
    blurb: 'Questionnaires, quantitative sensory testing, conditioned pain modulation and imaging markers, linked to the constructs they measure.',
    icon: 'M4 20 V10 M10 20 V4 M16 20 V13 M22 20 H2',
  },
];
const statusLabel = { live: 'Available', early: 'Early version', planned: 'Planned' };
---

<Base title="Pain Knowledge">
  <section class="hero">
    <p class="eyebrow">An open portal on pain science</p>
    <h1>Pain <em>Knowledge</em></h1>
    <p class="lede">Structured, evidence-linked modules on pain: what pain is, how it works, and how to treat it. Every entry follows a common format, cites verified sources, and can be downloaded as open data.</p>
    <p class="cta">
      <a class="btn btn-primary" href={url('theories/')}>Explore Pain Theories <span aria-hidden="true">→</span></a>
      <a class="btn" href={url('search/')}>Search the portal</a>
    </p>
  </section>

  <h2 class="sec">Modules</h2>
  <div class="modules">
    {modules.map((m) => {
      const Tag = m.href ? 'a' : 'div';
      return (
        <Tag class={`card module ${m.status}`} href={m.href ? url(m.href) : undefined}>
          <div class="mhead">
            <span class="micon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d={m.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class={`mstatus ${m.status}`}>{statusLabel[m.status]}</span>
          </div>
          <h3>{m.name}</h3>
          <p>{m.blurb}</p>
          {m.stats && <p class="mstats">{m.stats.join(' · ')}</p>}
          {m.href && <span class="mlink">Open module →</span>}
        </Tag>
      );
    })}
  </div>

  <style>
    .hero { padding: 1.5rem 0 2rem; max-width: 820px; }
    .hero h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); line-height: 1.02; margin-bottom: 1rem; }
    .hero h1 em { font-style: italic; font-weight: 450; color: var(--accent); }
    .cta { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }
    .sec { font-size: 1.35rem; margin-top: 2.5rem; }
    .modules { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
    .module.live { grid-column: span 2; }
    @media (max-width: 900px) { .modules { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .modules { grid-template-columns: 1fr; } .module.live { grid-column: auto; } }
    .module { display: flex; flex-direction: column; gap: .45rem; color: var(--ink); text-decoration: none; transition: transform .18s, box-shadow .18s; }
    a.module:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); }
    .module h3 { margin: .2rem 0 0; font-size: 1.3rem; }
    .module p { margin: 0; font-size: .92rem; color: var(--ink-2); }
    .module.planned { background: transparent; box-shadow: none; border-style: dashed; }
    .module.planned h3, .module.planned .micon { color: var(--ink-3); }
    .mhead { display: flex; justify-content: space-between; align-items: center; }
    .micon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--surface-2); color: var(--accent); }
    .mstatus { font-size: .72rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; padding: .2rem .55rem; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink-3); }
    .mstatus.live { color: var(--accent); border-color: currentColor; }
    .mstats { font-size: .82rem !important; color: var(--ink-3) !important; margin-top: auto !important; padding-top: .4rem; }
    .mlink { font-size: .88rem; font-weight: 500; color: var(--accent); }
  </style>
</Base>
