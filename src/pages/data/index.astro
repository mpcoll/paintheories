---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/data';
---
<Base title="Data" description="Download the Pain Theories Map as structured data.">
  <header class="page-head">
    <p class="eyebrow">Open data</p>
    <h1>Data</h1>
    <p class="lede">Everything on this site is generated from structured files. You can download it for analysis, reviews or teaching material. Licensed CC BY 4.0. Please <a href={url('about/#cite')}>cite</a> the map.</p>
  </header>
  <div class="table-wrap prose">
    <table>
      <thead><tr><th>File</th><th>Contents</th></tr></thead>
      <tbody>
        <tr><td><a href={url('data/theories.json')}>theories.json</a></td><td>All theories with every field, plus the controlled vocabularies.</td></tr>
        <tr><td><a href={url('data/theories.csv')}>theories.csv</a></td><td>One row per theory; list fields are separated by "; ".</td></tr>
        <tr><td><a href={url('data/evidence.csv')}>evidence.csv</a></td><td>One row per key finding: theory, direction (supports / contradicts / mixed), study type, finding and citation keys.</td></tr>
        <tr><td><a href={url('data/edges.csv')}>edges.csv</a></td><td>Theory-to-theory relations as an edge list (source, relation, target).</td></tr>
        <tr><td><a href={url('data/references.bib')}>references.bib</a></td><td>Full bibliography in BibTeX; keys match the citation keys used on the site.</td></tr>
      </tbody>
    </table>
  </div>
  <p class="muted" style="margin-top:1rem">Source files: <a href="https://github.com/mpcoll/paintheories/tree/main/src/content">src/content</a> (Markdown with YAML front matter) and <a href="https://github.com/mpcoll/paintheories/blob/main/src/data/references.yaml">references.yaml</a>.</p>
</Base>
