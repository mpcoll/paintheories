---
/** Static redirect page that keeps the query string and hash (e.g. ?focus=… or #anchor). */
import { url } from '../lib/data';
interface Props { to: string }
const target = url(Astro.props.to);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
  </head>
  <body><p>This page has moved to <a href={target}>{target}</a>.</p></body>
</html>
