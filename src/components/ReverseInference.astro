---
/**
 * Interactive Bayes demo of reverse inference: P(pain | region active) from
 * P(active | pain), P(active | no pain) and the base rate of pain.
 * Numbers are user-set and illustrative, not estimates for any real region.
 */
---
<div class="ri card" id="ri">
  <div class="ri-grid">
    <div class="ri-controls">
      <label>
        <span class="ri-q">How often is the region active <strong>when there is pain</strong>?</span>
        <span class="ri-row"><input type="range" min="0" max="100" step="1" value="90" data-k="sens" /><output data-o="sens">90%</output></span>
      </label>
      <label>
        <span class="ri-q">How often is it active <strong>in situations without pain</strong> (attention, surprise, other tasks)?</span>
        <span class="ri-row"><input type="range" min="0" max="100" step="1" value="40" data-k="fa" /><output data-o="fa">40%</output></span>
      </label>
      <label>
        <span class="ri-q">Before looking at the brain, how likely is it that <strong>pain is involved</strong>?</span>
        <span class="ri-row"><input type="range" min="1" max="99" step="1" value="20" data-k="prior" /><output data-o="prior">20%</output></span>
      </label>
      <div class="ri-presets" role="group" aria-label="Examples">
        <span>Try:</span>
        <button type="button" data-p="90,5,20">a selective region</button>
        <button type="button" data-p="90,40,20">a region active in many tasks</button>
        <button type="button" data-p="90,40,60">a pain experiment</button>
      </div>
    </div>
    <div class="ri-out">
      <p class="ri-big"><span class="ri-post">0%</span><span class="ri-cap">chance that pain is involved, given that the region is active</span></p>
      <p class="ri-change"></p>
      <div class="ri-dots" aria-hidden="true"></div>
      <p class="ri-key" aria-hidden="true">
        <span><i class="d pain act"></i>pain, region active</span>
        <span><i class="d other act"></i>no pain, region active</span>
        <span><i class="d pain"></i>pain, not active</span>
        <span><i class="d other"></i>no pain, not active</span>
      </p>
      <p class="ri-sr" aria-live="polite"></p>
    </div>
  </div>
</div>

<style>
  .ri { padding: 1rem 1.1rem; }
  .ri-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.4rem; align-items: start; }
  @media (max-width: 820px) { .ri-grid { grid-template-columns: 1fr; } }
  .ri-controls { display: grid; gap: .9rem; }
  .ri-controls label { display: grid; gap: .25rem; }
  .ri-q { font-size: .9rem; }
  .ri-row { display: grid; grid-template-columns: minmax(0, 1fr) 3.2rem; gap: .6rem; align-items: center; }
  .ri-row input { width: 100%; accent-color: var(--accent); }
  .ri-row output { font: 650 .95rem var(--font); font-variant-numeric: tabular-nums; text-align: right; }
  .ri-presets { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; font-size: .82rem; color: var(--ink-3); }
  .ri-presets button { font: 500 .8rem var(--font); color: var(--ink-2); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 999px; padding: .22rem .6rem; cursor: pointer; }
  .ri-presets button:hover { border-color: var(--accent); color: var(--accent-ink); }
  .ri-big { margin: 0; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  .ri-post { font: 700 2.6rem var(--serif); color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1; }
  .ri-cap { font-size: .88rem; color: var(--ink-2); max-width: 22ch; }
  .ri-change { font-size: .86rem; color: var(--ink-2); margin: .4rem 0 .7rem; }
  .ri-dots { display: grid; grid-template-columns: repeat(20, 1fr); gap: 3px; max-width: 360px; }
  .ri :global(.d) { display: inline-block; aspect-ratio: 1; border-radius: 50%; border: 1.5px solid var(--c); background: transparent; }
  .ri-key :global(.d) { width: 11px; }
  .ri :global(.pain) { --c: var(--d2); }
  .ri :global(.other) { --c: var(--ink-3); }
  .ri :global(.d.act) { background: var(--c); }
  .ri-key { display: flex; flex-wrap: wrap; gap: .3rem .9rem; font-size: .76rem; color: var(--ink-3); margin: .6rem 0 0; }
  .ri-key span { display: inline-flex; align-items: center; gap: .3rem; }
  .ri-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<script>
  const root = document.getElementById('ri')!;
  const inputs = Object.fromEntries([...root.querySelectorAll<HTMLInputElement>('input[data-k]')].map((i) => [i.dataset.k!, i]));
  const dots = root.querySelector<HTMLElement>('.ri-dots')!;
  dots.innerHTML = Array.from({ length: 200 }, () => '<i class="d"></i>').join('');
  const cells = [...dots.children] as HTMLElement[];
  function update() {
    const sens = +inputs.sens.value / 100, fa = +inputs.fa.value / 100, prior = +inputs.prior.value / 100;
    root.querySelectorAll<HTMLOutputElement>('output[data-o]').forEach((o) => (o.textContent = `${inputs[o.dataset.o!].value}%`));
    const post = (sens * prior) / (sens * prior + fa * (1 - prior) || 1);
    root.querySelector('.ri-post')!.textContent = `${Math.round(post * 100)}%`;
    root.querySelector('.ri-change')!.textContent = `Seeing the activation moves the probability from ${Math.round(prior * 100)}% to ${Math.round(post * 100)}%.`;
    // 200 situations: pain first, then no pain; active ones filled
    const nPain = Math.round(200 * prior), aPain = Math.round(nPain * sens), aOther = Math.round((200 - nPain) * fa);
    cells.forEach((c, i) => {
      const isPain = i < nPain;
      const act = isPain ? i < aPain : i - nPain < aOther;
      c.className = `d ${isPain ? 'pain' : 'other'}${act ? ' act' : ''}`;
    });
    root.querySelector('.ri-sr')!.textContent = `Out of 200 situations, ${aPain + aOther} show activation; ${aPain} of them involve pain.`;
  }
  Object.values(inputs).forEach((i) => i.addEventListener('input', update));
  root.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) => b.addEventListener('click', () => {
    const [s, f, p] = b.dataset.p!.split(',');
    inputs.sens.value = s; inputs.fa.value = f; inputs.prior.value = p; update();
  }));
  update();
</script>
