---
/**
 * Zones of hyperalgesia around a cutaneous injury, after the human capsaicin model of
 * LaMotte et al. (1991): nested areas of punctate hyperalgesia (≈55 cm²), allodynia to
 * stroking (≈38 cm²) and heat hyperalgesia (≈2 cm²). Radii are scaled to √area.
 */
import { getEntries } from 'astro:content';
import { cite, url, type Reference } from '../lib/data';

const CX = 250, CY = 190, K = 20; // px per √cm²
const rP = Math.sqrt(55) * K, rA = Math.sqrt(38) * K, rH = Math.sqrt(2) * K;
const probes = [
  { id: 'brush', label: 'Light brush', zones: { punct: 'normal', allo: 'allo', heat: 'allo', out: 'normal' },
    text: 'Gentle stroking, normally painless, becomes painful in a zone around the injury: dynamic mechanical allodynia. The zone extends well beyond the injured skin, which points to central sensitization rather than sensitised nociceptors at the site.',
    refs: ['lamotte1991', 'torebjork1992'] },
  { id: 'pinprick', label: 'Pinprick', zones: { punct: 'hyper', allo: 'hyper', heat: 'hyper', out: 'normal' },
    text: 'A pinprick hurts more over the largest zone: punctate hyperalgesia. In the surrounding, uninjured skin hyperalgesia is to mechanical stimuli only (secondary hyperalgesia), a sign of central sensitization; it outlasts the other changes, for up to a day in this model.',
    refs: ['lamotte1991', 'treede1992'] },
  { id: 'heat', label: 'Heat', zones: { punct: 'normal', allo: 'normal', heat: 'hyper', out: 'normal' },
    text: 'Heat hurts more only at and right around the injury (primary hyperalgesia), where nociceptors themselves are sensitised to heat. Secondary hyperalgesia in the surrounding skin does not extend to heat.',
    refs: ['treede1992', 'lamotte1991'] },
] as const;
const refIds = [...new Set(probes.flatMap((p) => p.refs))];
const refs = new Map(((await getEntries(refIds.map((id) => ({ collection: 'references' as const, id })))) as Reference[]).map((r) => [r.id, r]));
const payload = probes.map((p) => ({ ...p, refs: p.refs.map((id) => { const r = refs.get(id)!; return { label: cite(r), href: r.data.doi ? `https://doi.org/${r.data.doi}` : url(`references/#${id}`), title: r.data.title }; }) }));
---
<div class="hz card" id="hz">
  <div class="hz-buttons" role="group" aria-label="Test stimulus">
    <span class="hz-label">Test with</span>
    {probes.map((p, i) => <button type="button" class="chip" data-p={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>{p.label}</button>)}
  </div>
  <div class="hz-grid">
    <svg viewBox="0 0 560 380" role="img" aria-labelledby="hz-title">
      <title id="hz-title">Skin around an injury with three nested zones: a large zone of pinprick hyperalgesia, inside it a zone where light brushing is painful (allodynia), and at the centre a small zone of heat hyperalgesia. The colours show how each zone responds to the chosen test stimulus.</title>
      <rect class="skin" x="10" y="10" width="480" height="360" rx="40" />
      <circle class="zone" data-z="punct" cx={CX} cy={CY} r={rP} />
      <circle class="zone" data-z="allo" cx={CX} cy={CY} r={rA} />
      <circle class="zone" data-z="heat" cx={CX} cy={CY} r={rH} />
      <circle class="site" cx={CX} cy={CY} r="5" />
      <text class="t-xs" x={CX} y={CY + 20} text-anchor="middle">injury</text>
      <line class="lead" x1={CX + rH * .7} y1={CY - rH * .7} x2="402" y2="92" /><text class="zl" x="404" y="90">primary zone</text><text class="t-xs" x="404" y="105">heat + mechanical</text>
      <line class="lead" x1={CX + rA * .72} y1={CY + rA * .69} x2="430" y2="300" /><text class="zl" x="404" y="318">secondary zone</text><text class="t-xs" x="404" y="333">mechanical only</text>
    </svg>
    <div class="hz-side">
      <ul class="hz-legend">
        <li><span class="sw allo"></span>Painful, normally painless (allodynia)</li>
        <li><span class="sw hyper"></span>More painful than normal (hyperalgesia)</li>
        <li><span class="sw normal"></span>Normal sensation</li>
      </ul>
      <p class="hz-text" aria-live="polite"></p>
      <p class="hz-refs"></p>
    </div>
  </div>
  <p class="hz-foot">Zone areas after a capsaicin injection in human forearm skin (LaMotte et al. 1991): pinprick hyperalgesia ≈ 55 cm², allodynia to stroking ≈ 38 cm², heat hyperalgesia ≈ 2 cm². Drawn to scale relative to each other.</p>
</div>
<script type="application/json" id="hz-data" set:html={JSON.stringify(payload)} />

<style>
  .hz { padding: 1rem 1.1rem .7rem; }
  .hz-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-bottom: .5rem; }
  .hz-label { font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); margin-right: .2rem; }
  .chip { font: 500 .86rem var(--font); color: var(--ink-2); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 999px; padding: .32rem .8rem; cursor: pointer; }
  .chip:hover { border-color: var(--ink-3); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .hz-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 1.25rem; align-items: center; }
  @media (max-width: 820px) { .hz-grid { grid-template-columns: 1fr; } }
  svg { width: 100%; height: auto; display: block; }
  .skin { fill: color-mix(in srgb, var(--d5) 9%, var(--surface)); stroke: var(--line-strong); }
  .zone { stroke: var(--surface); stroke-width: 2; transition: fill .3s; fill: var(--surface-2); }
  .zone.allo { fill: color-mix(in srgb, var(--d1) 45%, var(--surface)); }
  .zone.hyper { fill: color-mix(in srgb, var(--d2) 45%, var(--surface)); }
  .zone.normal { fill: var(--surface-2); }
  .site { fill: var(--ink); }
  .lead { stroke: var(--ink-3); stroke-width: 1; }
  .zl { fill: var(--ink); font: 600 13px var(--font); }
  .t-xs { fill: var(--ink-3); font: 12px var(--font); }
  .hz-legend { list-style: none; padding: 0; margin: 0 0 .8rem; display: grid; gap: .35rem; font-size: .86rem; }
  .sw { display: inline-block; width: 14px; height: 14px; border-radius: 4px; margin-right: .5rem; vertical-align: -2px; border: 1px solid var(--line-strong); }
  .sw.allo { background: color-mix(in srgb, var(--d1) 45%, var(--surface)); }
  .sw.hyper { background: color-mix(in srgb, var(--d2) 45%, var(--surface)); }
  .sw.normal { background: var(--surface-2); }
  .hz-text { margin: 0 0 .5rem; }
  .hz-refs { font-size: .84rem; margin: 0; }
  .hz-refs a { text-decoration: none; }
  .hz-foot { font-size: .8rem; color: var(--ink-3); margin: .6rem 0 0; }
</style>

<script>
  const root = document.getElementById('hz')!;
  const P = JSON.parse(document.getElementById('hz-data')!.textContent!);
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function show(id: string) {
    const p = P.find((x: any) => x.id === id);
    root.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String((c as HTMLElement).dataset.p === id)));
    root.querySelectorAll<SVGCircleElement>('.zone').forEach((z) => { z.setAttribute('class', `zone ${p.zones[z.dataset.z!]}`); });
    root.querySelector('.hz-text')!.textContent = p.text;
    root.querySelector('.hz-refs')!.innerHTML = 'Sources: ' + p.refs.map((r: any) => `<a href="${r.href}" title="${esc(r.title)}">${esc(r.label)}</a>`).join(' · ');
  }
  root.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => b.addEventListener('click', () => show(b.dataset.p!)));
  show('brush');
</script>
