---
/**
 * Static SVG overview of every theory, placed by year (x) and domain (band),
 * with relation edges. Rendered at build time; every node links to its page.
 */
import type { Theory } from '../lib/data';
import { url } from '../lib/data';
import { DOMAINS, DOMAIN_STYLE } from '../data/taxonomy';

interface Props { theories: Theory[] }
const { theories } = Astro.props;

const W = 1000, PAD_L = 60, PAD_R = 70, SPLIT = 1850;
const years = theories.map((t) => t.data.year);
const minY = Math.min(...years), maxY = Math.max(...years);
const early = minY < SPLIT;
const x0 = early ? 190 : PAD_L;
const xFor = (y: number) =>
  y < SPLIT ? PAD_L + ((y - minY) / Math.max(1, SPLIT - minY)) * 60 : x0 + ((y - SPLIT) / Math.max(1, maxY - SPLIT)) * (W - PAD_R - x0);

// Pack nodes into sub-rows per domain band so labels don't overlap.
const MIN_GAP = 118, ROW_H = 46, BAND_GAP = 22, TOP = 26;
const allDomains = Object.keys(DOMAINS) as (keyof typeof DOMAINS)[];
// Only draw bands for domains that have entries.
const domains = allDomains.filter((d) => theories.some((t) => t.data.domain === d));
const sub: Record<string, number[]> = {};
const pos: Record<string, { x: number; sub: number }> = {};
for (const t of theories) {
  const x = xFor(t.data.year);
  const rows = (sub[t.data.domain] ??= []);
  let r = rows.findIndex((last) => x - last >= MIN_GAP);
  if (r === -1) { r = rows.length; rows.push(x); } else rows[r] = x;
  pos[t.id] = { x, sub: r };
}
const bandY: Record<string, number> = {};
let y = TOP;
const bands = domains.map((d) => {
  const n = Math.max(1, sub[d]?.length ?? 0);
  bandY[d] = y;
  const band = { d, y0: y - 18, h: n * ROW_H + 8 };
  y += n * ROW_H + BAND_GAP;
  return band;
});
const H = y + 30;
const P = (t: Theory) => ({ x: pos[t.id].x, y: bandY[t.data.domain] + pos[t.id].sub * ROW_H });

const byId = new Map(theories.map((t) => [t.id, t]));
const edges = theories.flatMap((t) =>
  t.data.relations.map((r) => {
    const a = P(t), b = P(byId.get(r.target.id)!);
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2 - Math.min(60, Math.abs(a.x - b.x) * 0.18);
    return { d: `M${a.x},${a.y} Q${mx},${my} ${b.x},${b.y}`, type: r.type, from: t.id, to: r.target.id };
  }),
);

const R = 7.5;
function shape(kind: string, cx: number, cy: number) {
  switch (kind) {
    case 'diamond': return `M${cx},${cy - R * 1.25} L${cx + R * 1.25},${cy} L${cx},${cy + R * 1.25} L${cx - R * 1.25},${cy} Z`;
    case 'round-rectangle': return `M${cx - R},${cy - R} h${2 * R} v${2 * R} h${-2 * R} Z`;
    case 'triangle': return `M${cx},${cy - R * 1.2} L${cx + R * 1.2},${cy + R * 0.9} L${cx - R * 1.2},${cy + R * 0.9} Z`;
    case 'hexagon': {
      const pts = Array.from({ length: 6 }, (_, i) => {
        const a = (Math.PI / 3) * i + Math.PI / 6;
        return `${cx + R * 1.12 * Math.cos(a)},${cy + R * 1.12 * Math.sin(a)}`;
      });
      return `M${pts.join(' L')} Z`;
    }
    default: return `M${cx - R},${cy} a${R},${R} 0 1,0 ${2 * R},0 a${R},${R} 0 1,0 ${-2 * R},0`;
  }
}
const ticks = [...(early ? [minY] : []), 1850, 1900, 1950, 2000].filter((t) => t <= maxY + 5);
---

<figure class="constellation">
  <div class="scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="const-title">
    <title id="const-title">All theories on the map, positioned by year of proposal and domain, with lines showing relations between them.</title>
    {bands.map((b, i) => <rect class="band" x="0" y={b.y0} width={W} height={b.h} rx="8" opacity={i % 2 ? 0 : 1} />)}
    {ticks.map((t) => (
      <g class="tick">
        <line x1={xFor(t)} x2={xFor(t)} y1={TOP - 18} y2={H - 30} />
        <text x={xFor(t)} y={H - 12} text-anchor="middle">{t}</text>
      </g>
    ))}
    <g class="edges">
      {edges.map((e) => <path d={e.d} class={`edge e-${e.type}`} data-from={e.from} data-to={e.to} />)}
    </g>
    {theories.map((t) => {
      const p = P(t);
      const st = DOMAIN_STYLE[t.data.domain];
      return (
        <a href={url(`theories/${t.id}/`)} class="node" data-id={t.id}>
          <title>{`${t.data.title} (${t.data.year}) — ${t.data.summary}`}</title>
          <path d={shape(st.shape, p.x, p.y)} style={`fill: var(--d${st.slot})`} />
          <text x={p.x} y={p.y + 22} text-anchor="middle">{t.data.shortTitle ?? t.data.title}</text>
        </a>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span class="hint">Swipe to see the full timeline →</span>
    <ul class="legend" aria-label="Domains">
      {allDomains.map((d) => <li><span class={`sym dom-${d}`} aria-hidden="true">{DOMAIN_STYLE[d].symbol}</span>{DOMAINS[d].label}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  .constellation { margin: 0; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .band { fill: var(--surface-2); opacity: 0.55; }
  .tick line, .break { stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 2 4; }
  .break { stroke-dasharray: none; stroke-width: 2; opacity: 0.6; }
  .tick text { fill: var(--ink-3); font: 500 12px var(--font); }
  .edge { fill: none; stroke: var(--ink-3); stroke-width: 1.4; opacity: 0.45; transition: opacity .2s, stroke-width .2s; }
  .e-challenges { stroke-dasharray: 5 4; }
  .e-integrates, .e-related-to { stroke-dasharray: 1 4; stroke-linecap: round; }
  .node path { stroke: var(--surface); stroke-width: 2.5; transition: transform .2s; transform-box: fill-box; transform-origin: center; }
  .node text { fill: var(--ink); font: 500 12.5px var(--font); paint-order: stroke; stroke: var(--bg); stroke-width: 4px; stroke-linejoin: round; }
  .node:hover path, .node:focus-visible path { transform: scale(1.35); }
  .node:hover text { fill: var(--accent); }
  svg:has(.node:hover) .edge { opacity: 0.12; }
  svg:has(.node:hover) .edge.on { opacity: 0.95; stroke-width: 2; stroke: var(--ink-2); }
  figcaption .legend { justify-content: center; margin-top: 0.75rem; }
  .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  @media (max-width: 760px) {
    svg { min-width: 760px; }
    .hint { display: block; }
  }
  .hint { display: none; text-align: center; font-size: 0.8rem; color: var(--ink-3); margin-top: 0.4rem; }
</style>

<script>
  // Highlight a node's relations on hover.
  document.querySelectorAll<SVGAElement>('.constellation .node').forEach((n) => {
    const id = n.dataset.id;
    const edges = document.querySelectorAll(`.constellation .edge[data-from="${id}"], .constellation .edge[data-to="${id}"]`);
    n.addEventListener('mouseenter', () => edges.forEach((e) => e.classList.add('on')));
    n.addEventListener('mouseleave', () => edges.forEach((e) => e.classList.remove('on')));
  });
</script>
