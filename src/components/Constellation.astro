---
/**
 * Static SVG overview of every theory, placed by year (x) and domain (band),
 * with relation edges. Rendered at build time; every node links to its page.
 */
import type { Theory } from '../lib/data';
import { url } from '../lib/data';
import { DOMAINS, DOMAIN_STYLE } from '../data/taxonomy';
import { makeTimeScale, tickYears } from '../lib/timescale';
import { filterCounts } from '../lib/filters';
import MapFilters from './MapFilters.astro';
import SizeToggle from './SizeToggle.astro';
import { computeMetrics, scales, fmt } from '../lib/metrics';

interface Props { theories: Theory[] }
const { theories } = Astro.props;

// Left gutter holds the domain labels for each band.
const W = 1280, GUTTER = 200, PAD_L = GUTTER + 50, PAD_R = 110;
const years = theories.map((t) => t.data.year);
const minY = Math.min(...years), maxY = Math.max(...years);
const xFor = makeTimeScale(minY, maxY, PAD_L, W - PAD_R);

// Pack nodes into sub-rows per domain band so labels don't overlap.
const MIN_GAP = 168, ROW_H = 40, BAND_GAP = 22, TOP = 48;
const allDomains = Object.keys(DOMAINS) as (keyof typeof DOMAINS)[];
// Only draw bands for domains that have entries.
const domains = allDomains.filter((d) => theories.some((t) => t.data.domain === d));
const sub: Record<string, number[]> = {};
const pos: Record<string, { x: number; sub: number }> = {};
for (const t of theories) {
  const x = xFor(t.data.year);
  const rows = (sub[t.data.domain] ??= []);
  let r = rows.findIndex((last) => x - last >= MIN_GAP);
  if (r === -1) { r = rows.length; rows.push(x); } else rows[r] = x;
  pos[t.id] = { x, sub: r };
}
const bandY: Record<string, number> = {};
let y = TOP;
const bands = domains.map((d) => {
  const n = Math.max(1, sub[d]?.length ?? 0);
  bandY[d] = y;
  const h = Math.max(n * ROW_H + 8, 70);
  const band = { d, y0: y - 18, h, count: theories.filter((t) => t.data.domain === d).length };
  y += h - 8 + BAND_GAP;
  return band;
});
const H = y + 22;
const P = (t: Theory) => ({ x: pos[t.id].x, y: bandY[t.data.domain] + pos[t.id].sub * ROW_H });

const byId = new Map(theories.map((t) => [t.id, t]));
const edges = theories.flatMap((t) =>
  t.data.relations.map((r) => {
    const a = P(t), b = P(byId.get(r.target.id)!);
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2 - Math.min(60, Math.abs(a.x - b.x) * 0.18);
    return { d: `M${a.x},${a.y} Q${mx},${my} ${b.x},${b.y}`, type: r.type, from: t.id, to: r.target.id };
  }),
);

const R = 7.5;
function shape(kind: string, cx: number, cy: number) {
  switch (kind) {
    case 'diamond': return `M${cx},${cy - R * 1.25} L${cx + R * 1.25},${cy} L${cx},${cy + R * 1.25} L${cx - R * 1.25},${cy} Z`;
    case 'round-rectangle': return `M${cx - R},${cy - R} h${2 * R} v${2 * R} h${-2 * R} Z`;
    case 'triangle': return `M${cx},${cy - R * 1.2} L${cx + R * 1.2},${cy + R * 0.9} L${cx - R * 1.2},${cy + R * 0.9} Z`;
    case 'hexagon': {
      const pts = Array.from({ length: 6 }, (_, i) => {
        const a = (Math.PI / 3) * i + Math.PI / 6;
        return `${cx + R * 1.12 * Math.cos(a)},${cy + R * 1.12 * Math.sin(a)}`;
      });
      return `M${pts.join(' L')} Z`;
    }
    default: return `M${cx - R},${cy} a${R},${R} 0 1,0 ${2 * R},0 a${R},${R} 0 1,0 ${-2 * R},0`;
  }
}
const ticks = tickYears(minY, maxY);
const metrics = computeMetrics(theories);
const { out: SC, maxC, maxI } = scales(metrics);
const LABEL_LINES: Record<keyof typeof DOMAINS, string[]> = {
  neurobiological: ['Neurobiological'],
  cognitive: ['Cognitive &', 'computational'],
  psychosocial: ['Behavioural &', 'psychosocial'],
  integrative: ['Integrative'],
  conceptual: ['Conceptual, evolutionary', '& sociocultural'],
};
---

<figure class="constellation">
  <MapFilters counts={filterCounts(theories)} />
  <SizeToggle maxCitations={maxC} maxInfluence={maxI} />
  <figcaption class="cap">
    <ul class="legend dom-legend" aria-label="Domains">
      {allDomains.map((d) => <li><span class={`sym dom-${d}`} aria-hidden="true">{DOMAIN_STYLE[d].symbol}</span>{DOMAINS[d].label}</li>)}
    </ul>
    <ul class="legend" aria-label="Relation types">
      <li><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" stroke="currentColor" stroke-width="2" /></svg>builds on / extends</li>
      <li><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray="5 4" /></svg>challenges</li>
      <li><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray="1 4" stroke-linecap="round" /></svg>integrates / related to</li>
      <li class="muted">Hover a theory to highlight its links</li>
    </ul>
    <span class="hint">Swipe to see the full timeline →</span>
  </figcaption>
  <div class="scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="const-title">
    <title id="const-title">All theories on the map, positioned by year of proposal and domain, with lines showing relations between them.</title>
    {bands.map((b) => {
      const st = DOMAIN_STYLE[b.d];
      const lines = LABEL_LINES[b.d];
      return (
        <a href={url(`theories/all/?domain=${b.d}`)} class="band-group">
          <title>{`${DOMAINS[b.d].label}: ${DOMAINS[b.d].description}`}</title>
          <rect class="band" x="0" y={b.y0} width={W} height={b.h} rx="10" style={`--bc: var(--d${st.slot})`} />
          <rect x="0" y={b.y0} width="5" height={b.h} rx="2.5" style={`fill: var(--d${st.slot})`} />
          <path d={shape(st.shape, 26, b.y0 + 24)} style={`fill: var(--d${st.slot})`} class="band-sym" />
          {lines.map((l, i) => <text class="band-label" x="44" y={b.y0 + 29 + i * 18}>{l}</text>)}
          <text class="band-count" x="44" y={b.y0 + 31 + lines.length * 18} data-domain={b.d} data-total={b.count}>{b.count} {b.count === 1 ? 'theory' : 'theories'} →</text>
        </a>
      );
    })}
    {ticks.map((t) => (
      <g class="tick">
        <line x1={xFor(t)} x2={xFor(t)} y1={TOP - 18} y2={H - 30} />
        <text x={xFor(t)} y={TOP - 26} text-anchor="middle">{t}</text>
        <text x={xFor(t)} y={H - 12} text-anchor="middle">{t}</text>
      </g>
    ))}
    <g class="edges">
      {edges.map((e) => <path d={e.d} class={`edge e-${e.type}`} data-from={e.from} data-to={e.to} />)}
    </g>
    {theories.map((t) => {
      const p = P(t);
      const st = DOMAIN_STYLE[t.data.domain];
      return (
        <a href={url(`theories/${t.id}/`)} class="node" data-id={t.id} data-domain={t.data.domain} data-kind={t.data.kind} data-questions={t.data.questions.join(' ')}
          data-sc={SC.get(t.id)!.citations ?? ''} data-si={SC.get(t.id)!.influence}>
          <title>{`${t.data.title} (${t.data.year}) — ${t.data.summary}\nCitations of founding work(s): ${metrics.get(t.id)!.citations === null ? 'unknown' : '≈ ' + fmt(metrics.get(t.id)!.citations!)} · Influence on this map: ${metrics.get(t.id)!.influence}`}</title>
          <path d={shape(st.shape, p.x, p.y)} style={`fill: var(--d${st.slot})`} />
          <text x={p.x} y={p.y + 22} text-anchor="middle">{t.data.shortTitle ?? t.data.title}</text>
        </a>
      );
    })}
  </svg>
  </div>

</figure>

<style>
  .constellation { margin: 0; }
  .scroll > svg { width: 100%; height: auto; display: block; overflow: visible; }
  .band { fill: color-mix(in srgb, var(--bc) 9%, var(--surface)); stroke: color-mix(in srgb, var(--bc) 22%, transparent); stroke-width: 1; }
  .band-label { fill: var(--ink); font: 600 15px var(--serif); }
  .band-count { fill: var(--ink-3); font: 500 12px var(--font); }
  .band-group:hover .band-count { fill: var(--accent); }
  .band-group:hover .band { fill: color-mix(in srgb, var(--bc) 14%, var(--surface)); }
  .band-sym { stroke: var(--surface); stroke-width: 2; }
  .cap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem; margin-bottom: 0.5rem; }
  .cap .legend { margin: 0; }
  .dom-legend { display: none; }
  @media (max-width: 760px) { .dom-legend { display: flex; } }
  .tick line, .break { stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 2 4; }
  .break { stroke-dasharray: none; stroke-width: 2; opacity: 0.6; }
  .tick text { fill: var(--ink-3); font: 500 12px var(--font); }
  .edge { fill: none; stroke: var(--ink-3); stroke-width: 1.2; opacity: 0.14; transition: opacity .2s, stroke-width .2s; }
  .e-challenges { stroke-dasharray: 5 4; }
  .e-integrates, .e-related-to { stroke-dasharray: 1 4; stroke-linecap: round; }
  .node path { stroke: var(--surface); stroke-width: 2.5; transition: transform .3s; transform-box: fill-box; transform-origin: center; transform: scale(var(--s, 1)); }
  .node.nodata path { fill-opacity: 0; stroke: var(--ink-3); stroke-width: 1.5; stroke-dasharray: 2 2; }
  .node text { fill: var(--ink); font: 500 12.5px var(--font); paint-order: stroke; stroke: var(--bg); stroke-width: 4px; stroke-linejoin: round; transition: transform .3s; transform: translateY(calc((var(--s, 1) - 1) * 9px)); }
  .node:hover path, .node:focus-visible path { transform: scale(calc(var(--s, 1) * 1.3)); }
  .node:hover text { fill: var(--accent); }
  svg:has(.node:hover) .edge { opacity: 0.05; }
  .node, .edge { transition: opacity .2s; }
  .node.off { opacity: 0.12; pointer-events: none; }
  .edge.off { opacity: 0 !important; }
  svg:has(.node:hover) .edge.on { opacity: 0.95; stroke-width: 2; stroke: var(--ink-2); }
  .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  @media (max-width: 760px) {
    .scroll > svg { min-width: 960px; }
    .hint { display: block; }
  }
  .hint { display: none; text-align: center; font-size: 0.8rem; color: var(--ink-3); margin-top: 0.4rem; }
</style>

<script>
  import { matchesFilter, type MapFilter } from '../lib/filters';

  // Fade theories (and their links) that don't match the type/scope filter.
  // Marker size by citations / influence (SizeToggle emits 'mapsize').
  window.addEventListener('mapsize', (e) => {
    const mode = (e as CustomEvent<{ mode: string }>).detail.mode;
    document.querySelectorAll<SVGAElement>('.constellation .node').forEach((n) => {
      const v = mode === 'citations' ? n.dataset.sc : mode === 'influence' ? n.dataset.si : '1';
      n.classList.toggle('nodata', mode === 'citations' && !v);
      n.style.setProperty('--s', v ? v : '0.55');
    });
  });

  window.addEventListener('mapfilter', (e) => {
    const f = (e as CustomEvent<MapFilter>).detail;
    const off = new Set<string>();
    let shown = 0;
    const nodes = document.querySelectorAll<SVGAElement>('.constellation .node');
    nodes.forEach((n) => {
      const ok = matchesFilter(n.dataset.kind!, n.dataset.questions!.split(' '), f);
      n.classList.toggle('off', !ok);
      if (ok) shown++; else off.add(n.dataset.id!);
    });
    document.querySelectorAll<SVGPathElement>('.constellation .edge').forEach((p) =>
      p.classList.toggle('off', off.has(p.dataset.from!) || off.has(p.dataset.to!)),
    );
    document.querySelectorAll<SVGTextElement>('.constellation .band-count').forEach((el) => {
      const total = Number(el.dataset.total);
      const n = [...nodes].filter((x) => x.dataset.domain === el.dataset.domain && !x.classList.contains('off')).length;
      el.textContent = n === total ? `${total} ${total === 1 ? 'theory' : 'theories'} →` : `${n} of ${total} shown →`;
    });
    window.dispatchEvent(new CustomEvent('mapfilter:count', { detail: { shown, total: nodes.length } }));
  });

  // Highlight a node's relations on hover.
  document.querySelectorAll<SVGAElement>('.constellation .node').forEach((n) => {
    const id = n.dataset.id;
    const edges = document.querySelectorAll(`.constellation .edge[data-from="${id}"], .constellation .edge[data-to="${id}"]`);
    n.addEventListener('mouseenter', () => edges.forEach((e) => e.classList.add('on')));
    n.addEventListener('mouseleave', () => edges.forEach((e) => e.classList.remove('on')));
  });
</script>
